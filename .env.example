# Copy this file to .env.local and replace the placeholders with your own values.
# .env.local is ignored by Git. Never commit real credentials.

# BetterAuth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MySQL database used by BetterAuth
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-your-database-password
MYSQL_DATABASE=bazardor

# Optional social providers. Leave blank to hide/disable that provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
